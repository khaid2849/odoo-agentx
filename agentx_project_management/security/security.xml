<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ================================================================ -->
        <!-- Security Groups                                                  -->
        <!-- ================================================================ -->

        <!-- Group: Viewer — read-only access to all project data -->
        <record id="group_agentx_project_viewer" model="res.groups">
            <field name="name">AgentX Project Viewer</field>
            <field name="category_id" ref="base.module_category_project"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Read-only access to all AgentX project data.</field>
        </record>

        <!-- Group: Project Member — view projects, CRUD own tasks, log timesheets -->
        <record id="group_agentx_project_member" model="res.groups">
            <field name="name">AgentX Project Member</field>
            <field name="category_id" ref="base.module_category_project"/>
            <field name="implied_ids" eval="[(4, ref('agentx_project_management.group_agentx_project_viewer'))]"/>
            <field name="comment">Can view projects and manage own tasks and bugs.</field>
        </record>

        <!-- Group: Project Manager — full CRUD on all records -->
        <record id="group_agentx_project_manager" model="res.groups">
            <field name="name">AgentX Project Manager</field>
            <field name="category_id" ref="base.module_category_project"/>
            <field name="implied_ids" eval="[(4, ref('agentx_project_management.group_agentx_project_member'))]"/>
            <field name="comment">Can create/manage projects, sprints, and all tasks.</field>
        </record>

        <!-- Group: Administrator — full access including configuration -->
        <record id="group_agentx_admin" model="res.groups">
            <field name="name">AgentX Administrator</field>
            <field name="category_id" ref="base.module_category_project"/>
            <field name="implied_ids" eval="[(4, ref('agentx_project_management.group_agentx_project_manager'))]"/>
            <field name="comment">Full administrative access to all AgentX records.</field>
        </record>

        <!-- ================================================================ -->
        <!-- Record Rules                                                     -->
        <!-- ================================================================ -->

        <!-- Rule 1: Project Member access — can only read projects where
             they are manager, team lead, or an allocated resource -->
        <record id="rule_agentx_project_user" model="ir.rule">
            <field name="name">AgentX Project: Member sees own projects</field>
            <field name="model_id" ref="agentx_project_management.model_agentx_project"/>
            <field name="domain_force">
                ['|', '|',
                    ('manager_id.user_id', '=', user.id),
                    ('team_lead_id.user_id', '=', user.id),
                    ('allocation_ids.employee_id.user_id', '=', user.id)
                ]
            </field>
            <field name="groups" eval="[(4, ref('agentx_project_management.group_agentx_project_member'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Rule 2: Task Member access — members can only write tasks
             they are assigned to (or tasks in projects they manage) -->
        <record id="rule_agentx_task_user" model="ir.rule">
            <field name="name">AgentX Task: Member edits own tasks</field>
            <field name="model_id" ref="agentx_project_management.model_agentx_task"/>
            <field name="domain_force">
                ['|',
                    ('assignee_id.user_id', '=', user.id),
                    ('project_id.manager_id.user_id', '=', user.id)
                ]
            </field>
            <field name="groups" eval="[(4, ref('agentx_project_management.group_agentx_project_member'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
