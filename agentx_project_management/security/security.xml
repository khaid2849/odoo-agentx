<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ================================================================ -->
        <!-- Security Groups                                                  -->
        <!-- ================================================================ -->

        <!-- Group: User — can view all and edit assigned records -->
        <record id="group_agentx_user" model="res.groups">
            <field name="name">AgentX User</field>
            <field name="category_id" ref="base.module_category_services_project"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Can view projects and manage own tasks and bugs.</field>
        </record>

        <!-- Group: Manager — full project and sprint management -->
        <record id="group_agentx_manager" model="res.groups">
            <field name="name">AgentX Manager</field>
            <field name="category_id" ref="base.module_category_services_project"/>
            <field name="implied_ids" eval="[(4, ref('agentx_project_management.group_agentx_user'))]"/>
            <field name="comment">Can create/manage projects, sprints, and all tasks.</field>
        </record>

        <!-- Group: Administrator — full access including configuration -->
        <record id="group_agentx_admin" model="res.groups">
            <field name="name">AgentX Administrator</field>
            <field name="category_id" ref="base.module_category_services_project"/>
            <field name="implied_ids" eval="[(4, ref('agentx_project_management.group_agentx_manager'))]"/>
            <field name="comment">Full administrative access to all AgentX records.</field>
        </record>

        <!-- ================================================================ -->
        <!-- Record Rules                                                     -->
        <!-- ================================================================ -->

        <!-- Rule 1: Users can only see projects they are a team member of
             (or are the project manager, or are an admin/manager) -->
        <record id="rule_agentx_project_user" model="ir.rule">
            <field name="name">AgentX Project: User sees own projects</field>
            <field name="model_id" ref="agentx_project_management.model_agentx_project"/>
            <field name="domain_force">
                ['|', '|',
                    ('manager_id.user_id', '=', user.id),
                    ('allocation_ids.employee_id.user_id', '=', user.id),
                    (1, '=', 1) if user.has_group('agentx_project_management.group_agentx_manager') else (0, '=', 1)
                ]
            </field>
            <field name="groups" eval="[(4, ref('agentx_project_management.group_agentx_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Rule 2: Users can only edit tasks assigned to them
             (managers bypass this rule by not being in group_agentx_user only) -->
        <record id="rule_agentx_task_user" model="ir.rule">
            <field name="name">AgentX Task: User edits own tasks</field>
            <field name="model_id" ref="agentx_project_management.model_agentx_task"/>
            <field name="domain_force">
                ['|',
                    ('assignee_id.user_id', '=', user.id),
                    ('project_id.manager_id.user_id', '=', user.id)
                ]
            </field>
            <field name="groups" eval="[(4, ref('agentx_project_management.group_agentx_user'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
