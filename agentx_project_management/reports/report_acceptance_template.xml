<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================== -->
    <!-- Acceptance Criteria QWeb PDF Report Template                       -->
    <!-- ================================================================== -->
    <template id="report_acceptance_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <!-- Header -->
                        <div class="row mb-4">
                            <div class="col-6">
                                <h2>Acceptance Criteria Report</h2>
                                <h3 class="text-muted">
                                    <t t-esc="o.code"/> — <t t-esc="o.name"/>
                                </h3>
                            </div>
                            <div class="col-6 text-end">
                                <span t-attf-class="badge fs-6
                                    #{ 'bg-success' if o.state == 'approved' else
                                       'bg-danger' if o.state == 'rejected' else
                                       'bg-info' if o.state == 'in_review' else 'bg-secondary' }">
                                    <t t-esc="dict(o._fields['state'].selection).get(o.state)"/>
                                </span>
                            </div>
                        </div>

                        <!-- Project Info -->
                        <table class="table table-sm table-borderless mb-4">
                            <tr>
                                <td class="fw-bold" style="width:180px">Project:</td>
                                <td><t t-esc="o.project_id.name"/></td>
                                <td class="fw-bold" style="width:180px">Customer:</td>
                                <td><t t-esc="o.project_id.customer_id.name or '—'"/></td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Reviewer:</td>
                                <td><t t-esc="o.reviewer_id.name or '—'"/></td>
                                <td class="fw-bold">Date Submitted:</td>
                                <td><t t-esc="o.date_submitted or '—'"/></td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Date Reviewed:</td>
                                <td><t t-esc="o.date_reviewed or '—'"/></td>
                                <td class="fw-bold">Project Manager:</td>
                                <td><t t-esc="o.project_id.manager_id.name or '—'"/></td>
                            </tr>
                        </table>

                        <!-- Description -->
                        <t t-if="o.description">
                            <h5 class="mt-3">Description</h5>
                            <div t-out="o.description"/>
                            <hr/>
                        </t>

                        <!-- Criteria Table -->
                        <h5 class="mt-3">Acceptance Criteria</h5>
                        <table class="table table-bordered table-sm">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:40px">#</th>
                                    <th>Criteria</th>
                                    <th style="width:100px">Result</th>
                                    <th>Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.criteria_line_ids" t-as="line">
                                    <tr t-attf-class="
                                        #{ 'table-success' if line.result == 'pass' else
                                           'table-danger' if line.result == 'fail' else '' }">
                                        <td class="text-center">
                                            <t t-esc="line_index + 1"/>
                                        </td>
                                        <td><t t-esc="line.description"/></td>
                                        <td class="text-center">
                                            <t t-if="line.result == 'pass'">
                                                <span class="badge bg-success">Pass</span>
                                            </t>
                                            <t t-elif="line.result == 'fail'">
                                                <span class="badge bg-danger">Fail</span>
                                            </t>
                                            <t t-else="">
                                                <span class="badge bg-secondary">N/A</span>
                                            </t>
                                        </td>
                                        <td><t t-esc="line.notes or ''"/></td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <td colspan="2" class="text-end fw-bold">Summary:</td>
                                    <td class="text-center">
                                        <span class="badge bg-success">
                                            <t t-esc="o.passed_count"/> Pass
                                        </span>
                                        <span class="badge bg-danger ms-1">
                                            <t t-esc="o.failed_count"/> Fail
                                        </span>
                                    </td>
                                    <td><t t-esc="o.criteria_count"/> total criteria</td>
                                </tr>
                            </tfoot>
                        </table>

                        <!-- Review Notes -->
                        <t t-if="o.review_notes">
                            <h5 class="mt-3">Review Notes</h5>
                            <p><t t-esc="o.review_notes"/></p>
                        </t>

                        <!-- Signature block -->
                        <div class="row mt-5">
                            <div class="col-6 text-center">
                                <div style="border-top: 1px solid #000; margin-top: 40px; padding-top: 5px;">
                                    Project Manager: <t t-esc="o.project_id.manager_id.name or '___________'"/>
                                </div>
                            </div>
                            <div class="col-6 text-center">
                                <div style="border-top: 1px solid #000; margin-top: 40px; padding-top: 5px;">
                                    Reviewer: <t t-esc="o.reviewer_id.name or '___________'"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- ================================================================== -->
    <!-- Project Summary QWeb PDF Report Template                           -->
    <!-- ================================================================== -->
    <template id="report_project_summary_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <!-- Header -->
                        <div class="row mb-4">
                            <div class="col-8">
                                <h2>Project Summary Report</h2>
                                <h3>
                                    [<t t-esc="o.code"/>] <t t-esc="o.name"/>
                                </h3>
                            </div>
                            <div class="col-4 text-end">
                                <span t-attf-class="badge fs-6
                                    #{ 'bg-success' if o.state == 'done' else
                                       'bg-primary' if o.state == 'in_progress' else
                                       'bg-secondary' }">
                                    <t t-esc="dict(o._fields['state'].selection).get(o.state)"/>
                                </span>
                            </div>
                        </div>

                        <!-- Project Details -->
                        <table class="table table-sm table-borderless mb-4">
                            <tr>
                                <td class="fw-bold" style="width:200px">Project Manager:</td>
                                <td><t t-esc="o.manager_id.name"/></td>
                                <td class="fw-bold" style="width:200px">Customer:</td>
                                <td><t t-esc="o.customer_id.name or '—'"/></td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Start Date:</td>
                                <td><t t-esc="o.date_start"/></td>
                                <td class="fw-bold">End Date:</td>
                                <td><t t-esc="o.date_end or '—'"/></td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Completion Rate:</td>
                                <td><t t-esc="'%.1f%%' % o.completion_rate"/></td>
                                <td class="fw-bold">Open Bugs:</td>
                                <td><t t-esc="o.open_bug_count"/></td>
                            </tr>
                        </table>

                        <!-- Team -->
                        <h5 class="mt-3">Team Members</h5>
                        <table class="table table-bordered table-sm">
                            <thead class="table-light">
                                <tr>
                                    <th>Name</th>
                                    <th>Role</th>
                                    <th>Allocation</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.team_ids" t-as="m">
                                    <tr>
                                        <td><t t-esc="m.employee_id.name"/></td>
                                        <td><t t-esc="dict(m._fields['role'].selection).get(m.role)"/></td>
                                        <td><t t-esc="'%.0f%%' % m.allocation_percent"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Sprint Summary -->
                        <h5 class="mt-3">Sprint Summary</h5>
                        <table class="table table-bordered table-sm">
                            <thead class="table-light">
                                <tr>
                                    <th>Sprint</th>
                                    <th>Period</th>
                                    <th>Tasks</th>
                                    <th>Done</th>
                                    <th>Completion</th>
                                    <th>Velocity</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.sprint_ids" t-as="s">
                                    <tr>
                                        <td><t t-esc="s.name"/></td>
                                        <td>
                                            <t t-esc="s.date_start"/> – <t t-esc="s.date_end"/>
                                        </td>
                                        <td class="text-center"><t t-esc="s.task_count"/></td>
                                        <td class="text-center"><t t-esc="s.done_task_count"/></td>
                                        <td class="text-center">
                                            <t t-esc="'%.0f%%' % s.completion_rate"/>
                                        </td>
                                        <td class="text-center"><t t-esc="s.velocity"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
