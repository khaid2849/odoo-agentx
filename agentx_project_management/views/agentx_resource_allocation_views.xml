<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================== -->
    <!-- agentx.resource.allocation — List View                             -->
    <!-- ================================================================== -->
    <record id="view_agentx_resource_allocation_list" model="ir.ui.view">
        <field name="name">agentx.resource.allocation.list</field>
        <field name="model">agentx.resource.allocation</field>
        <field name="arch" type="xml">
            <list string="Resource Allocations">
                <field name="project_id"/>
                <field name="employee_id"/>
                <field name="role"/>
                <field name="allocation_pct" string="Allocation (%)"/>
                <field name="start_date"/>
                <field name="end_date" optional="show"/>
                <field name="notes" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- agentx.resource.allocation — Form View                             -->
    <!-- ================================================================== -->
    <record id="view_agentx_resource_allocation_form" model="ir.ui.view">
        <field name="name">agentx.resource.allocation.form</field>
        <field name="model">agentx.resource.allocation</field>
        <field name="arch" type="xml">
            <form string="Resource Allocation">
                <sheet>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="employee_id"/>
                            <field name="role"/>
                        </group>
                        <group>
                            <field name="allocation_pct" string="Allocation (%)"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"
                               placeholder="Optional notes about this allocation period…"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- agentx.resource.allocation — Search View                           -->
    <!-- ================================================================== -->
    <record id="view_agentx_resource_allocation_search" model="ir.ui.view">
        <field name="name">agentx.resource.allocation.search</field>
        <field name="model">agentx.resource.allocation</field>
        <field name="arch" type="xml">
            <search string="Search Resource Allocations">
                <field name="project_id"/>
                <field name="employee_id"/>
                <field name="role"/>
                <filter string="Current Allocations" name="current"
                        domain="[('start_date', '&lt;=', context_today().strftime('%Y-%m-%d')),
                                 '|', ('end_date', '=', False),
                                      ('end_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Project" name="group_project"
                            context="{'group_by': 'project_id'}"/>
                    <filter string="Employee" name="group_employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter string="Role" name="group_role"
                            context="{'group_by': 'role'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- agentx.resource.allocation — Action                                -->
    <!-- ================================================================== -->
    <record id="action_agentx_resource_allocation" model="ir.actions.act_window">
        <field name="name">Resource Allocations</field>
        <field name="res_model">agentx.resource.allocation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_agentx_resource_allocation_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No resource allocations yet!
            </p>
            <p>Define formal time allocations for team members across project periods.</p>
        </field>
    </record>

</odoo>
