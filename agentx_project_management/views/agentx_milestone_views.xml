<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================== -->
    <!-- agentx.milestone — List View                                       -->
    <!-- ================================================================== -->
    <record id="view_agentx_milestone_list" model="ir.ui.view">
        <field name="name">agentx.milestone.list</field>
        <field name="model">agentx.milestone</field>
        <field name="arch" type="xml">
            <list string="Milestones"
                  decoration-success="state == 'achieved'"
                  decoration-danger="state == 'missed' or is_overdue">
                <field name="name"/>
                <field name="project_id"/>
                <field name="date_deadline"/>
                <field name="responsible_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'achieved'"
                       decoration-danger="state == 'missed'"
                       decoration-muted="state == 'pending'"/>
                <field name="is_overdue" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- agentx.milestone — Form View                                       -->
    <!-- ================================================================== -->
    <record id="view_agentx_milestone_form" model="ir.ui.view">
        <field name="name">agentx.milestone.form</field>
        <field name="model">agentx.milestone</field>
        <field name="arch" type="xml">
            <form string="Milestone">
                <header>
                    <button name="action_achieve" string="Mark Achieved" type="object"
                            class="btn-primary"
                            invisible="state != 'pending'"
                            confirm="Mark this milestone as achieved?"/>
                    <button name="action_miss" string="Mark Missed" type="object"
                            invisible="state != 'pending'"
                            confirm="Mark this milestone as missed?"/>
                    <button name="action_reopen" string="Reopen" type="object"
                            invisible="state != 'missed'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,achieved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Milestone Name…"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="date_deadline"/>
                            <field name="responsible_id"/>
                        </group>
                        <group>
                            <field name="is_overdue" readonly="1"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"
                               placeholder="Describe this milestone…"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- agentx.milestone — Action                                          -->
    <!-- ================================================================== -->
    <record id="action_agentx_milestone" model="ir.actions.act_window">
        <field name="name">Milestones</field>
        <field name="res_model">agentx.milestone</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'group_by': 'project_id'}</field>
    </record>

</odoo>
