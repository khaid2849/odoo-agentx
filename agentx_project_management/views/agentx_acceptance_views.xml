<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================== -->
    <!-- agentx.acceptance — List View                                      -->
    <!-- ================================================================== -->
    <record id="view_agentx_acceptance_list" model="ir.ui.view">
        <field name="name">agentx.acceptance.list</field>
        <field name="model">agentx.acceptance</field>
        <field name="arch" type="xml">
            <list string="Acceptance Criteria"
                  decoration-success="state == 'approved'"
                  decoration-danger="state == 'rejected'">
                <field name="code" optional="show"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="customer_id" optional="show"/>
                <field name="signee_name" optional="show"/>
                <field name="date" optional="show"/>
                <field name="reviewer_id"/>
                <field name="date_submitted" optional="show"/>
                <field name="date_reviewed" optional="show"/>
                <field name="criteria_count" string="Criteria"/>
                <field name="passed_count" string="Passed"/>
                <field name="failed_count" string="Failed"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"
                       decoration-info="state == 'in_review'"/>
            </list>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- agentx.acceptance — Form View                                      -->
    <!-- ================================================================== -->
    <record id="view_agentx_acceptance_form" model="ir.ui.view">
        <field name="name">agentx.acceptance.form</field>
        <field name="model">agentx.acceptance</field>
        <field name="arch" type="xml">
            <form string="Acceptance Criteria">
                <header>
                    <button name="action_submit" string="Submit for Review" type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object"
                            class="btn-primary"
                            invisible="state != 'in_review'"
                            groups="agentx_project_management.group_agentx_manager"
                            confirm="Approve acceptance criteria? This confirms project handover."/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state != 'in_review'"
                            groups="agentx_project_management.group_agentx_manager"
                            confirm="Reject acceptance criteria?"/>
                    <button name="action_resubmit" string="Resubmit" type="object"
                            class="btn-primary"
                            invisible="state != 'rejected'"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state == 'approved'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_review,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Acceptance Title…"/>
                        </h1>
                        <div>
                            <field name="code" class="text-muted" readonly="1"/>
                        </div>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="customer_id"/>
                            <field name="signee_name"/>
                            <field name="date"/>
                            <field name="sprint_ids" widget="many2many_tags"
                                   domain="[('project_id', '=', project_id)]"/>
                        </group>
                        <group>
                            <field name="reviewer_id"/>
                            <field name="date_submitted" readonly="1"/>
                            <field name="date_reviewed" readonly="1"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"
                               placeholder="Describe the acceptance scope…"/>
                    </group>
                    <notebook>
                        <page string="Acceptance Criteria" name="criteria">
                            <field name="criteria_line_ids">
                                <list editable="bottom"
                                      decoration-success="result == 'pass'"
                                      decoration-danger="result == 'fail'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="description"/>
                                    <field name="result" widget="badge"
                                           decoration-success="result == 'pass'"
                                           decoration-danger="result == 'fail'"/>
                                    <field name="notes" optional="show"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="criteria_count" string="Total Criteria"/>
                                <field name="passed_count"/>
                                <field name="failed_count"/>
                            </group>
                        </page>
                        <page string="Review Notes" name="review_notes"
                              invisible="state not in ('rejected', 'approved')">
                            <field name="review_notes" nolabel="1"
                                   placeholder="Notes from the review…"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- agentx.acceptance — Action                                         -->
    <!-- ================================================================== -->
    <record id="action_agentx_acceptance" model="ir.actions.act_window">
        <field name="name">Acceptance Criteria</field>
        <field name="res_model">agentx.acceptance</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'group_by': 'project_id'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No acceptance criteria defined!
            </p>
            <p>Define and track acceptance criteria for project handover.</p>
        </field>
    </record>

</odoo>
