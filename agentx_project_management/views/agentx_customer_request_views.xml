<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================== -->
    <!-- agentx.customer.request — List View                                -->
    <!-- ================================================================== -->
    <record id="view_agentx_customer_request_list" model="ir.ui.view">
        <field name="name">agentx.customer.request.list</field>
        <field name="model">agentx.customer.request</field>
        <field name="arch" type="xml">
            <list string="Customer Requests"
                  decoration-muted="state == 'rejected'"
                  decoration-success="state == 'approved'"
                  decoration-info="state in ('confirmed', 'in_analysis')">
                <field name="code" optional="show"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="customer_id" optional="show"/>
                <field name="assigned_to_id" optional="show"/>
                <field name="date_received"/>
                <field name="priority" widget="priority"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-info="state == 'in_analysis'"
                       decoration-secondary="state == 'confirmed'"
                       decoration-warning="state == 'draft'"
                       decoration-danger="state == 'rejected'"/>
                <field name="task_count" string="Tasks" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- agentx.customer.request — Form View                                -->
    <!-- ================================================================== -->
    <record id="view_agentx_customer_request_form" model="ir.ui.view">
        <field name="name">agentx.customer.request.form</field>
        <field name="model">agentx.customer.request</field>
        <field name="arch" type="xml">
            <form string="Customer Request">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_analyze" string="Start Analysis" type="object"
                            class="btn-primary"
                            invisible="state != 'confirmed'"/>
                    <button name="action_approve" string="Approve" type="object"
                            class="btn-primary"
                            invisible="state != 'in_analysis'"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state != 'in_analysis'"
                            confirm="Are you sure you want to reject this request?"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                            invisible="state != 'rejected'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,in_analysis,approved"/>
                </header>
                <sheet>
                    <!-- Stat buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_tasks" type="object"
                                class="oe_stat_button" icon="fa-tasks"
                                invisible="task_count == 0">
                            <field name="task_count" widget="statinfo" string="Tasks"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Request Title…"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" readonly="1"/>
                            <field name="project_id"/>
                            <field name="customer_id"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group>
                            <field name="date_received"/>
                            <field name="assigned_to_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" nolabel="1"/>
                        </page>
                        <page string="Tasks" name="tasks">
                            <field name="task_ids">
                                <list>
                                    <field name="code" optional="show"/>
                                    <field name="name"/>
                                    <field name="sprint_id" optional="show"/>
                                    <field name="assignee_id"/>
                                    <field name="story_points" optional="show"/>
                                    <field name="priority" widget="priority"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'done'"
                                           decoration-info="state == 'in_progress'"
                                           decoration-muted="state == 'cancelled'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- agentx.customer.request — Kanban View                             -->
    <!-- ================================================================== -->
    <record id="view_agentx_customer_request_kanban" model="ir.ui.view">
        <field name="name">agentx.customer.request.kanban</field>
        <field name="model">agentx.customer.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="code"/>
                <field name="project_id"/>
                <field name="customer_id"/>
                <field name="state"/>
                <field name="priority"/>
                <field name="assigned_to_id"/>
                <field name="task_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                        <span class="o_kanban_record_subtitle text-muted">
                                            <field name="code"/>
                                        </span>
                                    </div>
                                    <field name="priority" widget="priority" readonly="1"/>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="project_id"/>
                                    <div class="mt-1">
                                        <span class="badge bg-secondary">
                                            <i class="fa fa-tasks"/> <field name="task_count"/> tasks
                                        </span>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_right">
                                        <field name="assigned_to_id"
                                               widget="many2one_avatar_employee"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- agentx.customer.request — Search View                             -->
    <!-- ================================================================== -->
    <record id="view_agentx_customer_request_search" model="ir.ui.view">
        <field name="name">agentx.customer.request.search</field>
        <field name="model">agentx.customer.request</field>
        <field name="arch" type="xml">
            <search string="Search Customer Requests">
                <field name="name" string="Request"/>
                <field name="code"/>
                <field name="project_id"/>
                <field name="customer_id"/>
                <field name="assigned_to_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed"
                        domain="[('state', '=', 'confirmed')]"/>
                <filter string="In Analysis" name="in_analysis"
                        domain="[('state', '=', 'in_analysis')]"/>
                <filter string="Approved" name="approved"
                        domain="[('state', '=', 'approved')]"/>
                <filter string="Rejected" name="rejected"
                        domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter string="My Requests" name="my_requests"
                        domain="[('assigned_to_id.user_id', '=', uid)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Project" name="group_project"
                            context="{'group_by': 'project_id'}"/>
                    <filter string="Customer" name="group_customer"
                            context="{'group_by': 'customer_id'}"/>
                    <filter string="Priority" name="group_priority"
                            context="{'group_by': 'priority'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- agentx.customer.request — Actions                                  -->
    <!-- ================================================================== -->
    <record id="action_agentx_customer_request" model="ir.actions.act_window">
        <field name="name">Customer Requests</field>
        <field name="res_model">agentx.customer.request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_agentx_customer_request_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first customer request!
            </p>
            <p>
                Track customer requirements from receipt through analysis, approval, and delivery.
            </p>
        </field>
    </record>

    <record id="action_agentx_customer_request_my" model="ir.actions.act_window">
        <field name="name">My Requests</field>
        <field name="res_model">agentx.customer.request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('assigned_to_id.user_id', '=', uid)]</field>
        <field name="search_view_id" ref="view_agentx_customer_request_search"/>
    </record>

</odoo>
